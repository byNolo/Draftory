{
  "name": "draftory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "services/*"
  ],
  "engines": {
    "node": ">=22.13.0 <23 || >=24.0.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev:web": "npm run dev --workspace @draftory/web",
    "dev:api": "npm run dev --workspace @draftory/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:api": "npm run check --workspace @draftory/api",
    "types:api": "npm run types --workspace @draftory/api"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0"
  },
  "overrides": {
    "undici": "^7.30.1"
  }
}
