{
  "name": "draftory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "services/*"
  ],
  "engines": {
    "node": ">=22.13.0 <23 || >=24.0.0",
    "npm": ">=10"
  },
  "scripts": {
    "build:pilot": "node scripts/build-pilot.mjs",
    "test:data-client": "node scripts/build-pilot.mjs && playwright test --config apps/web/playwright.unit.config.ts",
    "test:integration": "playwright test --config apps/web/playwright.integration.config.ts --project chromium --project firefox --project webkit",
    "test:integration:edge": "playwright test --config apps/web/playwright.integration.config.ts --project edge",
    "test:api": "playwright test --config services/api/playwright.config.ts",
    "build:wasm": "node scripts/build-wasm.mjs",
    "test:browser": "playwright test --project chromium --project firefox --project webkit --project mobile-chromium --project mobile-webkit --project deployment",
    "test:edge": "playwright test --project edge",
    "bench:browser": "playwright test --project performance-chromium --project performance-firefox --project performance-webkit",
    "bench:edge": "playwright test --project performance-edge",
    "dev:web": "npm run dev --workspace @draftory/web",
    "dev:api": "npm run dev --workspace @draftory/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:api": "npm run check --workspace @draftory/api",
    "types:api": "npm run types --workspace @draftory/api"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.58.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0"
  },
  "overrides": {
    "undici": "^7.30.1"
  }
}
