{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://draftory.local/contracts/mlb-draft-catalog.schema.json",
  "title": "MLB experimental draft offer catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schemaVersion",
    "datasetId",
    "year",
    "sourceId",
    "profilePolicyId",
    "contextId",
    "researchMeasurementSha256",
    "pricingPolicy",
    "eligibilityPolicy",
    "sourceSqlSha256",
    "players",
    "attribution"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^draft-catalog:[a-f0-9]{64}$" },
    "schemaVersion": { "const": "1.0.0" },
    "datasetId": { "type": "string", "pattern": "^dataset:[a-f0-9]{64}$" },
    "year": { "const": 2024 },
    "sourceId": { "type": "string", "pattern": "^source:[a-f0-9]{64}$" },
    "profilePolicyId": { "type": "string", "pattern": "^policy:[a-f0-9]{64}$" },
    "contextId": { "type": "string", "pattern": "^context:[a-f0-9]{64}$" },
    "researchMeasurementSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceSqlSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "pricingPolicy": { "const": "m7a-linear-1-20-v1" },
    "eligibilityPolicy": { "const": "observed-10-universal-dh-v1" },
    "attribution": { "type": "string", "minLength": 1 },
    "players": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000,
      "items": { "$ref": "#/$defs/player" }
    }
  },
  "$defs": {
    "position": {
      "enum": ["C", "1B", "2B", "3B", "SS", "LF", "CF", "RF", "DH"]
    },
    "player": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "profileId",
        "positions",
        "games",
        "pa",
        "price"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^lahman:[a-z0-9]+$" },
        "name": { "type": "string", "minLength": 1 },
        "profileId": { "type": "string", "pattern": "^prepared:[a-f0-9]{64}$" },
        "positions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/position" }
        },
        "price": { "type": "integer", "minimum": 1, "maximum": 20 },
        "pa": { "type": "integer", "minimum": 50 },
        "games": {
          "type": "object",
          "minProperties": 9,
          "maxProperties": 9,
          "propertyNames": { "$ref": "#/$defs/position" },
          "additionalProperties": { "type": ["integer", "null"], "minimum": 0 }
        }
      }
    }
  }
}
