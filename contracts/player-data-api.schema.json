{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://draftory.example/contracts/player-data-api.schema.json",
  "title": "MLB player-data API envelopes v1.0.0",
  "description": "HTTP JSON contracts. Prepared profiles reuse the Rust input definition; semantic IDs, weight sums and compatibility are enforced by the producer and API.",
  "$defs": {
    "datasetId": { "type": "string", "pattern": "^dataset:[a-f0-9]{64}$" },
    "profileId": { "type": "string", "pattern": "^prepared:[a-f0-9]{64}$" },
    "playerId": { "type": "string", "pattern": "^lahman:[a-z0-9]{1,32}$" },
    "preparedProfile": {
      "allOf": [
        { "$ref": "simulation-input.schema.json#/$defs/profile" },
        {
          "required": ["provenance"],
          "properties": {
            "modelVersion": { "const": "lahman-contact-adapter-v1" },
            "weights": {
              "required": ["otherContact"],
              "properties": { "battedBallOut": { "const": 0 } }
            }
          }
        }
      ]
    },
    "batchRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["datasetId", "profileIds"],
      "properties": {
        "datasetId": { "$ref": "#/$defs/datasetId" },
        "profileIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/profileId" }
        }
      }
    },
    "profileResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "datasetId", "profile"],
      "properties": {
        "schemaVersion": { "const": "1.0.0" },
        "datasetId": { "$ref": "#/$defs/datasetId" },
        "profile": { "$ref": "#/$defs/preparedProfile" }
      }
    },
    "batchResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "datasetId", "profiles"],
      "properties": {
        "schemaVersion": { "const": "1.0.0" },
        "datasetId": { "$ref": "#/$defs/datasetId" },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "$ref": "#/$defs/preparedProfile" }
        }
      }
    },
    "playerListItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "profileId", "ordinal"],
      "properties": {
        "id": { "$ref": "#/$defs/playerId" },
        "displayName": { "type": "string" },
        "profileId": { "$ref": "#/$defs/profileId" },
        "ordinal": { "type": "integer", "minimum": 0 },
        "positionGames": { "type": "integer", "minimum": 1 }
      }
    },
    "playersResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "datasetId",
        "position",
        "players",
        "nextAfter"
      ],
      "properties": {
        "schemaVersion": { "const": "1.0.0" },
        "datasetId": { "$ref": "#/$defs/datasetId" },
        "position": {
          "enum": [
            null,
            "P",
            "C",
            "1B",
            "2B",
            "3B",
            "SS",
            "LF",
            "CF",
            "RF",
            "OF",
            "DH"
          ]
        },
        "players": {
          "type": "array",
          "maxItems": 50,
          "items": { "$ref": "#/$defs/playerListItem" }
        },
        "nextAfter": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error"],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string" },
            "message": { "type": "string" },
            "details": {}
          }
        }
      }
    }
  }
}
