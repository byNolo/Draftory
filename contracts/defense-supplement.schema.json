              "maximum": 4294967295
            }
          }
        },
        "RF": {
          "type": "object",
          "additionalProperties": false,
          "required": ["errors", "chances", "players"],
          "properties": {
            "errors": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "chances": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967295
            },
            "players": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967295
            }
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minInnings",
        "priorChances",
        "rounding",
        "referenceMinInnings"
      ],
      "properties": {
        "minInnings": {
          "const": 100
        },
        "priorChances": {
          "const": 1000
        },
        "rounding": {
          "const": "half-up-millionths"
        },
        "referenceMinInnings": {
          "const": 300
        }
      }
    },
    "attribution": {
      "type": "string",
      "minLength": 1
    }
  }
}
