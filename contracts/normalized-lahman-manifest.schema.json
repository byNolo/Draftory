{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Draftory normalized Lahman manifest v1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "files"],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "release", "lockSha256"],
      "properties": {
        "source": {
          "type": "string"
        },
        "release": {
          "type": "string"
        },
        "lockSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "rows", "sha256"],
        "properties": {
          "path": {
            "type": "string"
          },
          "rows": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
